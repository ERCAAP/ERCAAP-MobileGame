.unity-toolbar .unity-label {
}

.unity-toolbar .unity-toolbar-search-field {
    flex-shrink: 1;
    flex-grow: 1;
}

.toolbar-button {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 1px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    width: 40px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(196, 196, 196);
}

.toolbar-button__icon {
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(196, 196, 196);
    flex-grow: 1;
    margin-top: 2px;
    margin-right: 0;
    margin-bottom: 2px;
    margin-left: 0;
    background-image: none;
}

.unity-text-element {
    -unity-text-align: middle-left;
}

.Footer {
    flex-shrink: 0;
}

.Footer .unity-base-field {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.Footer .unity-base-field .unity-label {
    display: none;
}

.Footer .unity-base-field .unity-base-field__input {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.unity-enum-field__input {
    background-color: rgba(0, 0, 0, 0);
}

.unity-enum-field__input > .unity-text-element {
    background-color: rgba(0, 0, 0, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 2px;
    -unity-text-align: middle-left;
    font-size: 10px;
}

#Field_Inputs #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
}

#Field_Key #unity-text-input {
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-right-color: rgb(33, 33, 33);
    border-top-color: rgb(13, 13, 13);
    border-bottom-color: rgb(33, 33, 33);
    border-left-color: rgb(33, 33, 33);
}

#Field_Search #unity-text-input {
}

.unity-collection-view {
    background-color: rgba(0, 0, 0, 0.25);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
}

.system {
    transition-property: max-height, min-height;
    transition-delay: 0s, 0s;
    transition-timing-function: ease-in-back, ease-in-back;
    max-height: 0;
    min-height: 0;
    transition-duration: 0.3s, 0.3s;
}

.system .unity-repeat-button {
    display: none;
}

.system__active {
    transition-property: min-height, max-height;
    transition-delay: 0s, 0s;
    transition-timing-function: ease-out-back, ease-out-back;
    transition-duration: 0.3s, 0.3s;
    min-height: 20px;
    max-height: 200px;
}
